        "type": "function",
        "z": "16be0f85768927a6",
        "name": "Validasi dan Simpan Threshold",
        "func": "var body = msg.payload || {};\nvar batas = Number(body.threshold);\nif (!Number.isFinite(batas) || batas <= 0) {\n    msg.statusCode = 400;\n    msg.payload = {status:'error',message:'Threshold harus berupa angka positif'};\n    return msg;\n}\nflow.set('thresholdSuhu',batas);\nmsg.statusCode = 200;\nmsg.headers = {'Access-Control-Allow-Origin':'*'};\nmsg.payload = {status:'success',message:'Batas suhu berhasil diperbarui',threshold:batas};\nreturn msg;",
