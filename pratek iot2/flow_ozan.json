    {
        "id": "4453986bb7a2aefb",
        "type": "template",
        "z": "16be0f85768927a6",
        "name": "Dashboard Chart.js",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Monitoring ESP32</title>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<style>\nbody{font-family:Arial;background:#f1f5f9;margin:0;padding:25px;color:#1e293b}\n.container{max-width:950px;margin:auto;background:white;padding:25px;border-radius:12px}\nh2{text-align:center}\n.status{text-align:center;padding:12px;background:#e2e8f0;border-radius:8px}\n.cards{display:flex;gap:15px;flex-wrap:wrap;margin:20px 0}\n.card{flex:1;min-width:180px;padding:20px;background:#f1f5f9;border-radius:10px;text-align:center}\n.value{font-size:30px;font-weight:bold}\ncanvas{max-height:400px}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<h2>MONITORING SENSOR ESP32</h2>\n<div class=\"status\" id=\"status\">Menghubungkan WebSocket...</div>\n<div class=\"cards\">\n<div class=\"card\"><h3>Suhu</h3><div class=\"value\"><span id=\"suhu\">-</span> °C</div></div>\n<div class=\"card\"><h3>Kelembaban</h3><div class=\"value\"><span id=\"kelembaban\">-</span> %</div></div>\n<div class=\"card\"><h3>Batas Suhu</h3><div class=\"value\"><span id=\"batas\">35</span> °C</div></div>\n</div>\n<h3>Grafik Real-Time Sensor</h3>\n<canvas id=\"sensorChart\"></canvas>\n</div>\n<script>\nconst apiKey='KULIAH-API-2026';\nconst chart=new Chart(document.getElementById('sensorChart'),{\ntype:'line',data:{labels:[],datasets:[\n{label:'Suhu (°C)',data:[],borderColor:'red',tension:0.3},\n{label:'Kelembaban (%)',data:[],borderColor:'blue',tension:0.3}\n]},options:{responsive:true,animation:false,scales:{y:{beginAtZero:true}}}\n});\nconst protocol=location.protocol==='https:'?'wss://':'ws://';\nconst ws=new WebSocket(protocol+location.host+'/ws/sensor');\nws.onopen=()=>document.getElementById('status').innerText='ONLINE';\nws.onclose=()=>document.getElementById('status').innerText='OFFLINE';\nws.onerror=()=>document.getElementById('status').innerText='Koneksi WebSocket error';\nws.onmessage=(event)=>{\ntry{\nconst d=JSON.parse(event.data);\ndocument.getElementById('suhu').innerText=d.suhu??'-';\ndocument.getElementById('kelembaban').innerText=d.kelembaban??'-';\ndocument.getElementById('batas').innerText=d.threshold??35;\nconst waktu=new Date(d.waktu||Date.now()).toLocaleTimeString();\nchart.data.labels.push(waktu);\nchart.data.datasets[0].data.push(d.suhu);\nchart.data.datasets[1].data.push(d.kelembaban);\nif(chart.data.labels.length>20){chart.data.labels.shift();chart.data.datasets.forEach(x=>x.data.shift());}\nchart.update();\nif(d.status==='warning') document.getElementById('status').innerText='PERINGATAN: SUHU MELEBIHI BATAS';\nelse document.getElementById('status').innerText='ONLINE - Sensor Normal';\n}catch(e){console.error(e);}\n};\n</script>\n</body>\n</html>",
        "output": "str",
